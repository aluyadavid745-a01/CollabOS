ASPNETCORE_URLS=http://127.0.0.1:7040

# LiveKit Cloud credentials. Keep these out of the React/Vite env file.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret

# Firebase JWT validation. AUTH_AUDIENCE should match VITE_FIREBASE_PROJECT_ID.
AUTH_AUDIENCE=your-firebase-project-id
AUTH_AUTHORITY=https://securetoken.google.com/your-firebase-project-id

# Allowed local frontend origins.
COLLABOS_FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Optional email reminders/invites.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=your-email@gmail.com
